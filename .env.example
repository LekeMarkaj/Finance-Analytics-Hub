# ── Paddle billing ──────────────────────────────────────────────────────────
# The app selects sandbox vs live credentials based on PADDLE_ENVIRONMENT.
# Development runs against the Paddle SANDBOX account; the published app runs
# against the LIVE account. Never hard-code any of these values in source.

# "sandbox" (development) or "production" (published/live)
PADDLE_ENVIRONMENT=sandbox
VITE_PADDLE_ENVIRONMENT=sandbox

# Client-side token for Paddle.js (Developer tools > Authentication).
# Sandbox tokens start with test_, live tokens with live_.
VITE_PADDLE_CLIENT_TOKEN=test_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server-side API keys (Developer tools > Authentication > API keys).
# PADDLE_API_KEY       = sandbox API key (used when PADDLE_ENVIRONMENT=sandbox)
# PADDLE_API_KEY_LIVE  = live API key    (used when PADDLE_ENVIRONMENT=production)
PADDLE_API_KEY=
PADDLE_API_KEY_LIVE=

# Webhook signing secrets (Developer tools > Notifications > destination >
# endpoint_secret_key — shown once at creation, store it immediately).
# PADDLE_WEBHOOK_SECRET      = sandbox destination secret
# PADDLE_WEBHOOK_SECRET_LIVE = live destination secret
PADDLE_WEBHOOK_SECRET=
PADDLE_WEBHOOK_SECRET_LIVE=

# ── Clerk auth ──────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# ── AI ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=

# ── Database (managed by Replit) ────────────────────────────────────────────
DATABASE_URL=
